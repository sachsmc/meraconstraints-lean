import MeraConstraints.HiddenGraph.Components
import MeraConstraints.GlobalModel

/-!
# Realization using independent original graph inputs

The block-profile construction in `GlobalModel.lean` allows an arbitrary
partition of observed vertices. Here the blocks are the actual districts
of a hidden-variable graph, and every district has c-degree at most one.

Its independent input sources are precisely the latent roots and the private
disturbances of observed vertices without a latent parent. A mechanism reads
one listed latent parent when it has one, or its own private input otherwise.
Thus the construction respects the original graph, even when a directed
observed path leaves and re-enters a district.

The source/district bijection identifies the product law of these original
inputs with the product law of district profiles. Consequently **every**
choice of district profile distributions in the simplex is realized by this
original-input construction. Confounded vertices need no additional private
randomness in this realization; their private disturbances can be constants.

This proves a constructive sufficiency step in `prop:complete`. It does not
derive observable district factors or conditional independencies from graph
separation; those are separate identification and Markov obligations.
-/

namespace MeraConstraints.HiddenGraph

variable {n ℓ : ℕ} (G : Graph n ℓ) (val : Fin n → Type*)

abbrev DistrictProfile (d : DistrictId G) :=
  GlobalModel.Profile G.observed val (observedDistrict G) d

abbrev SourceProfile (s : Source G) := DistrictProfile G val (sourceDistrict G s)

/-- The original graph's structural mechanisms, before any probability law
is chosen. `sourceOf_latent_parent` verifies the chosen root is a parent. -/
noncomputable def sourceMechanisms (r : ∀ s, SourceProfile G val s) :
    RespAssign G.observed val :=
  fun i => r (sourceOf G i) ⟨i, (sourceOf_district G i).symm⟩

noncomputable def sourceToProfiles (hdegree : ∀ x, cDegree G x ≤ 1)
    (r : ∀ s, SourceProfile G val s) : ∀ d, DistrictProfile G val d :=
  Equiv.piCongrLeft (DistrictProfile G val) (sourceDistrictEquiv G hdegree) r

theorem sourceToProfiles_apply_source (hdegree : ∀ x, cDegree G x ≤ 1)
    (r : ∀ s, SourceProfile G val s) (s : Source G) :
    sourceToProfiles G val hdegree r (sourceDistrict G s) = r s :=
  Equiv.piCongrLeft_apply_apply (DistrictProfile G val) (sourceDistrictEquiv G hdegree) r s

private theorem profile_eval_transport (r : ∀ d, DistrictProfile G val d)
    (i : Fin n) (d : DistrictId G) (hi : observedDistrict G i = d)
    (pa : PaAssign G.observed val i) :
    r d ⟨i, hi⟩ pa = r (observedDistrict G i) ⟨i, rfl⟩ pa := by
  cases hi
  rfl

/-- Pointwise identity of the original-input and district-profile mechanisms. -/
theorem sourceMechanisms_eq_assemble (hdegree : ∀ x, cDegree G x ≤ 1)
    (r : ∀ s, SourceProfile G val s) :
    sourceMechanisms G val r = GlobalModel.assemble G.observed val (observedDistrict G)
      (sourceToProfiles G val hdegree r) := by
  funext i pa
  have h := congrArg (fun f => f ⟨i, (sourceOf_district G i).symm⟩ pa)
    (sourceToProfiles_apply_source G val hdegree r (sourceOf G i))
  change r (sourceOf G i) ⟨i, (sourceOf_district G i).symm⟩ pa =
    sourceToProfiles G val hdegree r (observedDistrict G i) ⟨i, rfl⟩ pa
  exact h.symm.trans (profile_eval_transport G val (sourceToProfiles G val hdegree r)
    i _ (sourceOf_district G i).symm pa)

variable [∀ i, Fintype (val i)] [∀ i, DecidableEq (val i)]
  [DecidableEq (DistrictId G)]

omit [∀ i, Fintype (val i)] [∀ i, DecidableEq (val i)]
  [DecidableEq (DistrictId G)] in
/-- Independent original input law induces exactly the desired district joint
profile mass after reindexing. The degree assumption prevents root dependence. -/
theorem source_joint_reindex (hdegree : ∀ x, cDegree G x ≤ 1)
    (q : ∀ d, DistrictProfile G val d → ℝ) (r : ∀ s, SourceProfile G val s) :
    Independent.joint (fun s => q (sourceDistrict G s)) r =
      Independent.joint q (sourceToProfiles G val hdegree r) := by
  classical
  unfold Independent.joint
  rw [← (sourceDistrictEquiv G hdegree).prod_comp
    (fun d => q d (sourceToProfiles G val hdegree r d))]
  apply Finset.prod_congr rfl
  intro s _
  change q (sourceDistrict G s) (r s) =
    q (sourceDistrict G s) (sourceToProfiles G val hdegree r (sourceDistrict G s))
  rw [sourceToProfiles_apply_source]

/-- Observed law generated by mutually independent inputs attached only to
actual latent roots and private unconfounded nodes in the original graph. -/
noncomputable def sourceObserved (q : ∀ d, DistrictProfile G val d → ℝ) :
    FullAssign val → ℝ := by
  classical
  exact pushforward (fun r => evalR (sourceMechanisms G val r))
    (Independent.joint (fun s => q (sourceDistrict G s)))

theorem sourceObserved_mem_stdSimplex
    (q : ∀ d, DistrictProfile G val d → ℝ)
    (hq : ∀ d, q d ∈ stdSimplex ℝ (DistrictProfile G val d)) :
    sourceObserved G val q ∈ stdSimplex ℝ (FullAssign val) := by
  classical
  exact pushforward_mem_stdSimplex _ _
    (Independent.joint_mem_stdSimplex _ (fun s => hq (sourceDistrict G s)))

/-- Every independent district-profile model is realized by independent
original graph inputs when the district c-degrees are at most one. -/
theorem sourceObserved_eq_observed (hdegree : ∀ x, cDegree G x ≤ 1)
    (q : ∀ d, DistrictProfile G val d → ℝ) :
    sourceObserved G val q =
      GlobalModel.observed G.observed val (observedDistrict G) q := by
  classical
  funext w
  unfold sourceObserved GlobalModel.observed pushforward
  simp only [Finset.sum_filter]
  apply Fintype.sum_equiv
    (Equiv.piCongrLeft (DistrictProfile G val) (sourceDistrictEquiv G hdegree))
  intro r
  rw [sourceMechanisms_eq_assemble G val hdegree r,
    source_joint_reindex G val hdegree q r]
  rfl

end MeraConstraints.HiddenGraph
