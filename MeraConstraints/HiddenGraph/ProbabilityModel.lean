import MeraConstraints.HiddenGraph.MeasureCanonicalization
import MeraConstraints.HiddenGraph.Measurability

/-!
# A structural model with independent inputs

A distribution in the marginal model of the manuscript is generated by a
structural model on the hidden variables DAG, with mutually independent
unobserved variables and private noise. `HiddenGraph.ProbabilityModel` records
this: a `HiddenGraph.SCM`, a probability space, and random inputs on it that are
measurable and mutually independent, with measurable structural equations.
The inputs may take values in any measurable spaces. The field list contains no
constraints on the observed distribution.

The structure puts all input types in one universe. The theorems of
`Canonicalization.lean` allow different universes.
-/

namespace MeraConstraints.HiddenGraph

open MeasureTheory ProbabilityTheory

universe u

variable {n ℓ : ℕ} (G : Graph n ℓ) (val : Fin n → Type u)
variable [∀ i, MeasurableSpace (val i)]

/-- A structural model on the hidden variables DAG `G`, with mutually
independent random inputs on a probability space. -/
structure ProbabilityModel where
  model : HiddenGraph.SCM.{u, u, u} G val
  sample : Type u
  sampleSpace : MeasurableSpace sample
  inputSpaces : ∀ x, MeasurableSpace (Canonicalization.InputValue model x)
  measure : @Measure sample sampleSpace
  probability : @IsProbabilityMeasure sample sampleSpace measure
  inputs : ∀ x, sample → Canonicalization.InputValue model x
  measurableInputs : ∀ x,
    @Measurable sample (Canonicalization.InputValue model x) sampleSpace (inputSpaces x) (inputs x)
  independent :
    letI := sampleSpace
    letI := inputSpaces
    iIndepFun inputs measure
  measurableMechanisms :
    letI := inputSpaces
    Measurability.MechanismsMeasurable model

namespace ProbabilityModel

variable {G val}

/-- The observed distribution generated by the model: the probability of each
joint value of the observed variables. -/
noncomputable def observed (P : ProbabilityModel G val) : FullAssign val → ℝ :=
  letI := P.sampleSpace
  MeasureFinite.law P.measure
    (fun ω => Canonicalization.evalInputs P.model (fun x => P.inputs x ω))

variable [DecidableEq (DistrictId G)]
variable [∀ i, Fintype (val i)] [∀ i, DecidableEq (val i)]
variable [∀ i, MeasurableSingletonClass (val i)]

/-- The observed distribution of a `ProbabilityModel` is a probability vector. -/
theorem observed_mem_stdSimplex (P : ProbabilityModel G val) :
    P.observed ∈ stdSimplex ℝ (FullAssign val) := by
  letI := P.sampleSpace
  letI := P.inputSpaces
  letI := P.probability
  exact MeasureCanonicalization.observedLaw_mem_stdSimplex P.model P.measure P.inputs
    P.measurableInputs P.independent
    (Measurability.localProfile_measurable P.model P.measurableMechanisms)

end ProbabilityModel
end MeraConstraints.HiddenGraph
