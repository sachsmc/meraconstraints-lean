import MeraConstraints.HiddenGraph.StrongFaceBundling
import MeraConstraints.HiddenGraph.StrongFaceNativeTransport

/-!
# Proposition 6 (`prop:strong`): Strong Face Splitting

The theorem `original_model_iff_strongFaceSplitting` says that a distribution `p` of
the observed variables is generated by a structural model with independent
unobserved inputs on the original graph if and only if it is generated by one on the
split graph. So the two graphs have the same marginal model, and
`constraint_valid_iff_strongFaceSplitting` states the manuscript's conclusion that
they have the same constraints. The graphs satisfy Condition 1 (`A1`) only, because
splitting can break Condition 2 (`A2`); they are `RootGraph`s and the models are
`RootProbabilityModel`s (`HiddenGraph.StrongFaceSplitting`). The hypotheses are
`Conditions`, which are slightly weaker than the manuscript's; finitely many
selected and other unobserved variables; and finitely many values for each observed
variable, each a measurable space with measurable singletons. No positivity of `p`
and no c-degree assumption is needed.

**Every split model is an original model** (`probabilityModel_bundleSplit`). Put the
input of the new unobserved variable with children `D` into one selected variable,
the anchor, whose children include `D`. Every other selected variable receives its
own `C_i`-input and an unused constant. The original model then computes the same
observed values from the same sample space, with inputs that are again independent.
This uses `h.selected_nonempty` to choose the anchor.

**Every original model is a split model** (`probabilityModel_replayStrong`). The
variables in `D` have no common unobserved parent with `C`. They are given a
shared stream of independent candidate draws from the law of the original inputs.
Each variable in `D` checks locally whether a candidate reproduces the observed
values of `C`, given the observed values of the parents of `C`, and uses the first
candidate that does. This is conditional replay. The first accepted candidate has the
law of the original inputs conditioned on reproducing the observed values of `C` and
its parents, so replacing the corresponding original inputs by it preserves their
joint law, and therefore the observed distribution. The sample space of the split
model is the pair of the original inputs and the stream.

The chapters of this argument are:

* `HiddenGraph.StrongFaceSplitting`: the graphs, `Conditions`, and the bundled model.
* `HiddenGraph.StrongFaceBundling`: the bundled model has independent inputs.
* `HiddenGraph.StrongFaceReplay`, `StrongFaceReverse`: the local test, and the split
  model built from an original model.
* `Probability.ReplaySelection`, `ReplayLaw`, `ReplayTrials`, `ReplayContext`,
  `ReplayContextLaw`: the first accepted candidate has the conditional law.
* `Probability.ReplaySupport`, `ReplayInvariance`: resampling keeps the observation
  with positive probability, and preserves the law of the inputs.
* `HiddenGraph.StrongFaceFibers`, `StrongFaceInputs`, `StrongFaceSupport`: the
  acceptance test is a fiber of the observed boundary, the inputs form two
  independent blocks, and some trial is accepted almost surely.
* `HiddenGraph.StrongFaceMeasurability`, `StrongFaceCoupling`, `StrongFaceAlignment`,
  `StrongFaceIndependence`, `StrongFaceLaw`, `StrongFaceNativeTransport`: the split
  model has measurable mechanisms and independent inputs, and the original observed
  distribution.
-/

namespace MeraConstraints.Completeness

open MeasureTheory ProbabilityTheory HiddenGraph.StrongFaceSplitting

universe u

variable {n : ℕ} {K J : Type u} [Fintype K] [Fintype J]
  (A : CausalDAG n) (C : K → Finset (Fin n)) (D : Finset (Fin n))
  (other : J → Finset (Fin n)) (val : Fin n → Type u) [∀ i, MeasurableSpace (val i)]

/-- From a split model `P`, the model on the original graph with the same sample
space in which the `D`-input of `P` is placed in the anchor variable. The
`constant` fills the unused slot of the other selected variables. -/
noncomputable def probabilityModel_bundleSplit
    (P : RootProbabilityModel (splitGraph A C D other) val)
    (anchor : K) (constant : P.model.rootValue (.inl none)) :
    RootProbabilityModel (originalGraph A C D other) val := by
  classical
  letI := P.sampleSpace
  letI := P.rootSpaces
  letI := P.privateSpaces
  exact {
    model := bundledModel A C D other P.model anchor
    sample := P.sample
    sampleSpace := P.sampleSpace
    rootSpaces := fun r => bundledModelRootMeasurableSpace A C D other P.model anchor r
    privateSpaces := P.privateSpaces
    measure := P.measure
    probability := P.probability
    roots := fun r ω => (bundleEncode A C D other P.model anchor constant (P.nativeInputs ω)).1 r
    privateInputs := P.privateInputs
    measurableRoots := fun r => (measurable_pi_apply r).comp
      (((bundleEncode_measurable A C D other P.model anchor constant).comp P.nativeInputs_measurable).fst)
    measurablePrivate := P.measurablePrivate
    independent := bundleEncode_independent A C D other P.model P.measure P.nativeInputs
      P.nativeInputs_measurable P.independent anchor constant
    measurableMechanisms := bundledModel_mechanismsMeasurable A C D other P.model P.measurableMechanisms anchor }

theorem probabilityModel_bundleSplit_observed
    (P : RootProbabilityModel (splitGraph A C D other) val)
    (anchor : K) (constant : P.model.rootValue (.inl none)) :
    (probabilityModel_bundleSplit A C D other val P anchor constant).observed = P.observed := by
  classical
  letI := P.sampleSpace
  change P.measure.map (fun ω => (bundledModel A C D other P.model anchor).eval
    (encodeSplitInputs A C D other P.model anchor constant (fun r => P.roots r ω))
    (fun i => P.privateInputs i ω)) =
      P.measure.map (fun ω => P.model.eval (fun r => P.roots r ω) (fun i => P.privateInputs i ω))
  apply congrArg (fun f => P.measure.map f)
  funext ω
  exact split_eval_reproduced A C D other P.model anchor constant _ _

variable [∀ i, Fintype (val i)] [∀ i, MeasurableSingletonClass (val i)]
  (h : Conditions A C D other)

/-- From an original model `P`, a split model whose sample space consists of the
original inputs and a stream of candidates. Its probability measure is the product
of the law of the original inputs and the law of an independent stream of draws from
it, and its mechanisms are those of `replayModel`. -/
noncomputable def probabilityModel_replayStrong
    (P : RootProbabilityModel (originalGraph A C D other) val) :
    RootProbabilityModel (splitGraph A C D other) val := by
  letI := P.rootSpaces
  letI := P.privateSpaces
  letI := P.nativeLaw_probability
  exact {
    model := replayModel A C D other h P.model
    sample := P.model.NativeInputs × (ℕ → P.model.NativeInputs)
    sampleSpace := inferInstance
    rootSpaces := fun r => replayModelRootValueMeasurableSpace A C D other h P.model r
    privateSpaces := P.privateSpaces
    measure := P.nativeLaw.prod (MeraConstraints.Replay.trialMeasure P.nativeLaw)
    probability := inferInstance
    roots := fun r z => (replayNativeEncode A C D other h P.model z).1 r
    privateInputs := fun i z => z.1.2 i
    measurableRoots := fun r => (measurable_pi_apply r).comp
      (replayNativeEncode_measurable A C D other h P.model).fst
    measurablePrivate := fun i => (measurable_pi_apply i).comp measurable_fst.snd
    independent := replayNativeEncode_independent A C D other h P.model P.nativeLaw P.nativeLaw_independent
    measurableMechanisms := replayModel_mechanismsMeasurable A C D other h P.model P.measurableMechanisms }

theorem probabilityModel_replayStrong_observed
    (P : RootProbabilityModel (originalGraph A C D other) val) :
    (probabilityModel_replayStrong A C D other val h P).observed = P.observed := by
  letI := P.rootSpaces
  letI := P.privateSpaces
  letI := P.nativeLaw_probability
  change (P.nativeLaw.prod (MeraConstraints.Replay.trialMeasure P.nativeLaw)).map
    (coupledReplayEval A C D other h P.model) = P.observed
  rw [coupledReplayEval_map A C D other h P.model P.nativeLaw P.measurableMechanisms
    (replayInput_independent_native A C D other P.model P.nativeLaw P.nativeLaw_independent)]
  exact P.observed_eq_nativeLaw.symm

include h in
/-- Proposition 6 (`prop:strong`): a distribution `p` of the observed variables is
generated by a model on the original graph if and only if it is generated by a model
on the split graph. Observed values of probability zero are allowed. -/
theorem original_model_iff_strongFaceSplitting (p : Measure (FullAssign val)) :
    (∃ P : RootProbabilityModel (originalGraph A C D other) val, P.observed = p) ↔
      ∃ Q : RootProbabilityModel (splitGraph A C D other) val, Q.observed = p := by
  classical
  constructor
  · rintro ⟨P, hp⟩
    exact ⟨probabilityModel_replayStrong A C D other val h P,
      (probabilityModel_replayStrong_observed A C D other val h P).trans hp⟩
  · rintro ⟨Q, hq⟩
    let anchor := Classical.choice h.selected_nonempty
    let constant := Classical.choice (Q.model.rootNonempty (.inl none))
    exact ⟨probabilityModel_bundleSplit A C D other val Q anchor constant,
      (probabilityModel_bundleSplit_observed A C D other val Q anchor constant).trans hq⟩

include h in
/-- A property `F` of observed distributions holds for every model on the original
graph if and only if it holds for every model on the split graph. This is the
manuscript's conclusion that the two graphs have the same constraints. -/
theorem constraint_valid_iff_strongFaceSplitting (F : Measure (FullAssign val) → Prop) :
    (∀ P : RootProbabilityModel (originalGraph A C D other) val, F P.observed) ↔
      ∀ Q : RootProbabilityModel (splitGraph A C D other) val, F Q.observed := by
  classical
  constructor
  · intro hF Q
    let anchor := Classical.choice h.selected_nonempty
    let constant := Classical.choice (Q.model.rootNonempty (.inl none))
    rw [← probabilityModel_bundleSplit_observed A C D other val Q anchor constant]
    exact hF _
  · intro hF P
    rw [← probabilityModel_replayStrong_observed A C D other val h P]
    exact hF _

end MeraConstraints.Completeness
