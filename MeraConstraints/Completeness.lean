import MeraConstraints.Reconstruction
import MeraConstraints.Identification
import MeraConstraints.HiddenGraph.Realization
import MeraConstraints.HiddenGraph.SCMRealization

/-!
# The response function model and its H-representation constraints

This is the first stage of the proof of Proposition 3 (`prop:complete`). The
chapters of `Completeness/` build up to the marginal model of the manuscript in
stages:

1. This file: the response function model (`sourceObserved`), in which the
   distribution `q d` of the response function variables of each district is
   chosen freely and the districts are independent. This is an intermediate
   step, not the marginal model. The matrix has complete observed assignments as
   rows here.
2. `Completeness/Compact.lean`: the same equivalence with the rows `(v₁, v₂)` of
   the manuscript's matrix `B`.
3. `Completeness/OriginalFinite.lean` and `OriginalMeasure.lean`: every
   structural model satisfies the constraints. `Completeness/ProbabilityModel.lean`
   states the equivalence for `ProbabilityModel`, the marginal model.
4. `Completeness/Graphical.lean`, `Boundary.lean` and `Global.lean`: the
   conditional independencies implied by the graph, the zero-probability case,
   and the final statements behind Proposition 3 and Remark 2 (`rmk:positivity`).
   `Completeness/Global.lean` holds the statements that `MainResults.prop_complete`
   and `MainResults.rmk_positivity` cite.

The theorems here show that, at c-degree at most 1, a strictly positive
distribution `p` is generated by the response function model exactly when it
satisfies the ordered local Markov property and the H-representation
constraints on each district factor. The proof of sufficiency uses the ordered
Markov equations to reduce the chain-rule factors to the conditioning sets
`C_i`. It then uses the H-representation to find a distribution `q d` for each
district, and the c-degree bound to match districts with independent
unobserved variables.
-/

namespace MeraConstraints.Completeness

open HiddenGraph

variable {n ℓ : ℕ} (G : HiddenGraph.Graph n ℓ) (val : Fin n → Type*)
variable [DecidableEq (DistrictId G)]
variable [∀ i, Fintype (val i)] [∀ i, DecidableEq (val i)]

/-- Sufficiency in Proposition 3 (`prop:complete`) for the response function
model: if `p` is strictly positive, satisfies the ordered local Markov property
and each district factor lies in the district polytope, then `p` is generated by
independent response function variables, one per district. -/
theorem realize_of_orderedMarkov_and_factor_feasible
    (hdegree : ∀ x, cDegree G x ≤ 1) (p : FullAssign val → ℝ)
    (hp : p ∈ stdSimplex ℝ (FullAssign val)) (hpos : ∀ w, 0 < p w)
    (hMarkov : Reconstruction.OrderedMarkov G.observed val (observedDistrict G) p)
    (hfeasible : ∀ d, Reconstruction.districtFactor G.observed val
      (observedDistrict G) p d ∈
        Polytope.mixture (GlobalModel.matrix G.observed val (observedDistrict G) d)) :
    ∃ q : ∀ d, DistrictProfile G val d → ℝ,
      (∀ d, q d ∈ stdSimplex ℝ (DistrictProfile G val d)) ∧
      sourceObserved G val q = p := by
  classical
  obtain ⟨q, hq, hobs⟩ := Reconstruction.realize_of_factor_feasible
    G.observed val (observedDistrict G) p hp hpos hMarkov hfeasible
  exact ⟨q, hq, (sourceObserved_eq_observed G val hdegree q).trans hobs⟩

/-- The same, with the district polytope given by an H-representation `H`. Here
the rows of the matrix are complete assignments, so rows repeat. The
manuscript's matrix `B` has rows `(v₁, v₂)`, which is the case in
`Completeness/Compact.lean`. -/
theorem realize_of_orderedMarkov_and_HRep
    (hdegree : ∀ x, cDegree G x ≤ 1)
    {I E : DistrictId G → Type*}
    (H : ∀ d, Polytope.HRep
      (GlobalModel.matrix G.observed val (observedDistrict G) d) (I d) (E d))
    (p : FullAssign val → ℝ) (hp : p ∈ stdSimplex ℝ (FullAssign val))
    (hpos : ∀ w, 0 < p w)
    (hMarkov : Reconstruction.OrderedMarkov G.observed val (observedDistrict G) p)
    (hH : ∀ d,
      (∀ i, ∑ w, (H d).inequalities i w *
        Reconstruction.districtFactor G.observed val (observedDistrict G) p d w ≤
          (H d).upper i) ∧
      (∀ e, ∑ w, (H d).equalities e w *
        Reconstruction.districtFactor G.observed val (observedDistrict G) p d w =
          (H d).target e)) :
    ∃ q : ∀ d, DistrictProfile G val d → ℝ,
      (∀ d, q d ∈ stdSimplex ℝ (DistrictProfile G val d)) ∧
      sourceObserved G val q = p := by
  classical
  apply realize_of_orderedMarkov_and_factor_feasible G val hdegree p hp hpos hMarkov
  intro d
  exact ((H d).exact_representation _).mpr (hH d)

/-- Under the hypotheses of the first theorem, `p` is the observed distribution
of a structural model on `G` whose unobserved inputs are mutually independent. Private
noise that a variable does not use is set to a constant, which needs the observed
variables to have at least one value. -/
theorem realize_with_explicit_SCM [∀ i, Nonempty (val i)]
    (hdegree : ∀ x, cDegree G x ≤ 1) (p : FullAssign val → ℝ)
    (hp : p ∈ stdSimplex ℝ (FullAssign val)) (hpos : ∀ w, 0 < p w)
    (hMarkov : Reconstruction.OrderedMarkov G.observed val (observedDistrict G) p)
    (hfeasible : ∀ d, Reconstruction.districtFactor G.observed val
      (observedDistrict G) p d ∈
        Polytope.mixture (GlobalModel.matrix G.observed val (observedDistrict G) d)) :
    ∃ q : ∀ d, DistrictProfile G val d → ℝ,
      (∀ d, q d ∈ stdSimplex ℝ (DistrictProfile G val d)) ∧
      pushforward
        (fun r => (profileSCM G val).eval
          (sourceLatentInput G val r) (sourcePrivateInput G val r))
        (Independent.joint (fun s => q (sourceDistrict G s))) = p := by
  classical
  obtain ⟨q, hq, hobs⟩ := realize_of_orderedMarkov_and_factor_feasible
    G val hdegree p hp hpos hMarkov hfeasible
  exact ⟨q, hq, (sourceObserved_eq_profileSCM G val q).symm.trans hobs⟩

/-- Proposition 3 (`prop:complete`) for the response function model, at c-degree
at most 1: a strictly positive `p` is generated by independent response function
variables exactly when it satisfies the ordered local Markov property and the
H-representation constraints on every district factor. This is about the
response function model only; the marginal model is treated in
`Completeness/ProbabilityModel.lean`. -/
theorem finite_source_iff_HRep
    (hdegree : ∀ x, cDegree G x ≤ 1)
    {I E : DistrictId G → Type*}
    (H : ∀ d, Polytope.HRep
      (GlobalModel.matrix G.observed val (observedDistrict G) d) (I d) (E d))
    (p : FullAssign val → ℝ) (hp : p ∈ stdSimplex ℝ (FullAssign val))
    (hpos : ∀ w, 0 < p w) :
    (∃ q : ∀ d, DistrictProfile G val d → ℝ,
      (∀ d, q d ∈ stdSimplex ℝ (DistrictProfile G val d)) ∧
        sourceObserved G val q = p) ↔
    Reconstruction.OrderedMarkov G.observed val (observedDistrict G) p ∧
      ∀ d,
        (∀ i, ∑ w, (H d).inequalities i w *
          Reconstruction.districtFactor G.observed val (observedDistrict G) p d w ≤
            (H d).upper i) ∧
        (∀ e, ∑ w, (H d).equalities e w *
          Reconstruction.districtFactor G.observed val (observedDistrict G) p d w =
            (H d).target e) := by
  constructor
  · rintro ⟨q, hq, hobs⟩
    apply (Identification.finite_profile_iff_HRep G.observed val (observedDistrict G) H p hp hpos).mp
    exact ⟨q, hq, (sourceObserved_eq_observed G val hdegree q).symm.trans hobs⟩
  · intro hc
    obtain ⟨q, hq, hobs⟩ :=
      (Identification.finite_profile_iff_HRep G.observed val (observedDistrict G) H p hp hpos).mpr hc
    exact ⟨q, hq, (sourceObserved_eq_observed G val hdegree q).trans hobs⟩

end MeraConstraints.Completeness
