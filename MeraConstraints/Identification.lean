import MeraConstraints.Reconstruction
import MeraConstraints.GlobalModel.Prefix
import MeraConstraints.GlobalModel.OrderedMarkov

/-!
# Identifying the district factor in the model of block profiles

For a strictly positive distribution generated by independent block profiles, the
district factor `Pdo` computed from the observed distribution equals the vector
`factor = B r` computed from the profiles (`generated_factor_eq_districtFactor`).
This is Proposition 1 (`prop:ident`) for the model of block profiles. The product of
conditionals given all predecessors is `GlobalModel.factor_eq_prod_prefixConditional`;
the ordered local Markov property, which is proved for generated distributions in
`GlobalModel.observed_orderedMarkov`, replaces the predecessors by `C_i`.

The chapter also characterizes the model. A strictly positive `p` is generated by
independent block profiles if and only if it satisfies `OrderedMarkov` and every
district factor lies in the district polytope (`finite_profile_iff_constraints`), or
satisfies an H-representation (`finite_profile_iff_HRep`). The rows of the matrix here
are complete assignments, not the manuscript's `(v₁, v₂)`. The reduction of a structural
model with arbitrary measurable unobserved inputs to this model is in
`HiddenGraph.MeasureCanonicalization`, and the resulting statements of Propositions 1
and 2 are in `Identification.OriginalMeasure`.
-/

namespace MeraConstraints.Identification

open FiniteProbability

variable {n : ℕ} (G : CausalDAG n) (val : Fin n → Type*)
variable {D : Type*} [Fintype D] [DecidableEq D] (block : Fin n → D)
variable [∀ i, Fintype (val i)] [∀ i, DecidableEq (val i)]

/-- For a strictly positive distribution generated by block profiles and satisfying
`OrderedMarkov`, `factor` equals the district factor. The hypothesis `hMarkov` is
removed in `generated_factor_eq_districtFactor`. -/
theorem structuralFactor_eq_districtFactor
    (q : ∀ d, GlobalModel.Profile G val block d → ℝ)
    (hq : ∀ d, q d ∈ stdSimplex ℝ (GlobalModel.Profile G val block d))
    (hpos : ∀ w, 0 < GlobalModel.observed G val block q w)
    (hMarkov : Reconstruction.OrderedMarkov G val block (GlobalModel.observed G val block q))
    (d : D) (w : FullAssign val) :
    GlobalModel.factor G val block q d w =
      Reconstruction.districtFactor G val block (GlobalModel.observed G val block q) d w := by
  classical
  rw [GlobalModel.factor_eq_prod_prefixConditional G val block q hq hpos d w]
  let f := fun i : Fin n => conditional (GlobalModel.observed G val block q)
    (valueEvent val w i) (Reconstruction.conditioningEvent G val block w i)
  calc
    _ = ∏ i ∈ Finset.univ.filter (fun i => block i = d), f i := by
      apply Finset.prod_congr rfl
      intro i _
      exact conditional_eq_of_subset_independent _ _ _ _
        (Reconstruction.prefixEvent_subset_conditioningEvent G val block w i)
        (hMarkov w i) (prefix_mass_pos val _ hpos w i.val).ne'
        (mass_pos_of_mem hpos (Reconstruction.self_mem_conditioningEvent G val block w i)).ne'
    _ = _ := Finset.prod_subtype _ (by intro i; simp) f

/-- Among strictly positive distributions satisfying `OrderedMarkov`, `p` is generated
by independent block profiles if and only if every district factor lies in its
district polytope. -/
theorem finite_profile_iff_factor_feasible (p : FullAssign val → ℝ)
    (hp : p ∈ stdSimplex ℝ (FullAssign val)) (hpos : ∀ w, 0 < p w)
    (hMarkov : Reconstruction.OrderedMarkov G val block p) :
    (∃ q : ∀ d, GlobalModel.Profile G val block d → ℝ,
      (∀ d, q d ∈ stdSimplex ℝ (GlobalModel.Profile G val block d)) ∧
        GlobalModel.observed G val block q = p) ↔
    ∀ d, Reconstruction.districtFactor G val block p d ∈
      Polytope.mixture (GlobalModel.matrix G val block d) := by
  constructor
  · rintro ⟨q, hq, hobs⟩ d
    have hposq : ∀ w, 0 < GlobalModel.observed G val block q w := by simpa [hobs] using hpos
    have hMarkovq : Reconstruction.OrderedMarkov G val block (GlobalModel.observed G val block q) := by
      simpa [hobs] using hMarkov
    have hfactor : GlobalModel.factor G val block q d =
        Reconstruction.districtFactor G val block p d := by
      funext w
      simpa [hobs] using structuralFactor_eq_districtFactor G val block q hq hposq hMarkovq d w
    rw [← hfactor]
    exact GlobalModel.factor_mem_mixture G val block q hq d
  · exact Reconstruction.realize_of_factor_feasible G val block p hp hpos hMarkov

/-- For a strictly positive distribution generated by independent block profiles,
`factor` equals the district factor. The ordered local Markov property is proved
(`GlobalModel.observed_orderedMarkov`), not assumed. -/
theorem generated_factor_eq_districtFactor
    (q : ∀ d, GlobalModel.Profile G val block d → ℝ)
    (hq : ∀ d, q d ∈ stdSimplex ℝ (GlobalModel.Profile G val block d))
    (hpos : ∀ w, 0 < GlobalModel.observed G val block q w) (d : D) (w : FullAssign val) :
    GlobalModel.factor G val block q d w =
      Reconstruction.districtFactor G val block (GlobalModel.observed G val block q) d w :=
  structuralFactor_eq_districtFactor G val block q hq hpos
    (GlobalModel.observed_orderedMarkov G val block q hpos) d w

/-- A strictly positive `p` is generated by independent block profiles if and only if
it satisfies `OrderedMarkov` and every district factor lies in its district polytope. -/
theorem finite_profile_iff_constraints (p : FullAssign val → ℝ)
    (hp : p ∈ stdSimplex ℝ (FullAssign val)) (hpos : ∀ w, 0 < p w) :
    (∃ q : ∀ d, GlobalModel.Profile G val block d → ℝ,
      (∀ d, q d ∈ stdSimplex ℝ (GlobalModel.Profile G val block d)) ∧
        GlobalModel.observed G val block q = p) ↔
    Reconstruction.OrderedMarkov G val block p ∧
      ∀ d, Reconstruction.districtFactor G val block p d ∈
        Polytope.mixture (GlobalModel.matrix G val block d) := by
  constructor
  · intro hmodel
    obtain ⟨q, hq, hobs⟩ := hmodel
    have hMarkov : Reconstruction.OrderedMarkov G val block p := by
      have hposq : ∀ w, 0 < GlobalModel.observed G val block q w := by simpa [hobs] using hpos
      simpa [hobs] using GlobalModel.observed_orderedMarkov G val block q hposq
    exact ⟨hMarkov, (finite_profile_iff_factor_feasible G val block p hp hpos hMarkov).mp
      ⟨q, hq, hobs⟩⟩
  · rintro ⟨hMarkov, hfeasible⟩
    exact (finite_profile_iff_factor_feasible G val block p hp hpos hMarkov).mpr hfeasible

/-- The same, with the H-representation constraints `H d` on each district factor in
place of membership in the district polytope. -/
theorem finite_profile_iff_HRep {I E : D → Type*}
    (H : ∀ d, Polytope.HRep (GlobalModel.matrix G val block d) (I d) (E d))
    (p : FullAssign val → ℝ) (hp : p ∈ stdSimplex ℝ (FullAssign val))
    (hpos : ∀ w, 0 < p w) :
    (∃ q : ∀ d, GlobalModel.Profile G val block d → ℝ,
      (∀ d, q d ∈ stdSimplex ℝ (GlobalModel.Profile G val block d)) ∧
        GlobalModel.observed G val block q = p) ↔
    Reconstruction.OrderedMarkov G val block p ∧
      ∀ d,
        (∀ i, ∑ w, (H d).inequalities i w * Reconstruction.districtFactor G val block p d w ≤
          (H d).upper i) ∧
        (∀ e, ∑ w, (H d).equalities e w * Reconstruction.districtFactor G val block p d w =
          (H d).target e) := by
  rw [finite_profile_iff_constraints G val block p hp hpos]
  apply and_congr_right
  intro _
  constructor
  · intro hf d
    exact ((H d).exact_representation _).mp (hf d)
  · intro hf d
    exact ((H d).exact_representation _).mpr (hf d)

end MeraConstraints.Identification
